# Aether01 is an ESP32-S31 design. Do not substitute ESP32-S3.
CONFIG_IDF_TARGET="esp32s31"
CONFIG_SPI_FLASH_SUPPORT_WINBOND_CHIP=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_BUILTIN_MALLOC=n
# Allocate UI objects in PSRAM; hardware buffers and task stacks keep explicit caps.
# CONFIG_LV_USE_CLIB_MALLOC is not set
CONFIG_LV_USE_CUSTOM_MALLOC=y

# W25Q512JV external flash: 512 Mbit = 64 MiB.
CONFIG_ESPTOOLPY_FLASHSIZE_64MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="64MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Return Chinese directory entries as UTF-8; CP936 also supplies GBK decoding.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_CODEPAGE_936=y
CONFIG_FATFS_API_ENCODING_UTF_8=y

# Fitted memory: 32 MiB octal PSRAM.  Keep startup strict so a PSRAM wiring or
# timing fault is visible instead of silently degrading media functions.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_PRE_CONFIGURE_MEMORY_PROTECTION=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# Official external BSS for lwIP/net80211/pp/bt/wpa_supplicant; keep driver DMA
# and task stacks internal while preserving Wi-Fi/H264 IRAM acceleration.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Retain RTC/LP memory for ordinary system tasks. The S31 H264 allocator shim
# excludes LP specifically from its vector work buffers without reducing the
# memory available to Bluetooth/Wi-Fi and other services.
CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP=y

# UI/logging defaults.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# LVGL 9 settings used by the bring-up screen.
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=8
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_CALENDAR_CHINESE=y
CONFIG_ESP_LCD_TOUCH_MAX_POINTS=2

CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_DEVICE_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
# CONFIG_BT_A2DP_USE_EXTERNAL_CODEC is not set
CONFIG_ESP_H264_S31_USE_ASM=y
# CONFIG_ESP_H264_DUAL_TASK is not set
# Keep contiguous HP memory for both media stacks after radio lifecycle changes.
# Optional codec/Wi-Fi fast paths run through the existing200MHz PSRAM XIP;
# mandatory/sleep IRAM paths, stack capacities and DMA guards stay unchanged.
# CONFIG_ESP_H264_DECODER_IRAM is not set
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_WIFI_EXTRA_IRAM_OPT is not set

# CONFIG_ESP_AUDIO_CODEC_S31_USE_ASM is not set
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_AETHER_LCD_BUFFER_LINES=20
CONFIG_AETHER_LCD_PCLK_HZ=48000000
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
# CONFIG_BTDM_CTRL_MODE_BTDM is not set
# CONFIG_BTDM_CTRL_MODE_BLE_ONLY is not set
# CONFIG_BT_BLE_ENABLED is not set
CONFIG_BT_CTRL_BR_EDR_MAX_ACL_CONN=2
CONFIG_BT_CTRL_BR_EDR_MAX_SYNC_CONN=0
# CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED is not set

CONFIG_TINYUSB_MSC_ENABLED=y

CONFIG_TINYUSB_MSC_BUFSIZE=16384

# UVC composite cameras can report configuration descriptors over 256 bytes.
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096

# CONFIG_TINYUSB_CDC_ENABLED is not set

# Preserve common multi-rate UAC1 descriptors; application rejects larger tables
# before the official driver can index a truncated frequency array.
CONFIG_UAC_FREQ_NUM_MAX=32
